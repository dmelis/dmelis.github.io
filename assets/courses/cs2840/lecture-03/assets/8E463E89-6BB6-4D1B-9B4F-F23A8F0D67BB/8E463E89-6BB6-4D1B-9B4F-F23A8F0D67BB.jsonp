00234331401,"width":1068.8831999999993,"height":47.05920422077179}},{"text":"Coupling tells us “which source points map to which target points” (probabilistically).","targetRectangle":{"y":394.00000023841858,"x":227.00000234331401,"width":1077.1487999999997,"height":88.05920422077179}},{"text":"Embedding alignment","targetRectangle":{"y":483.00000035762787,"x":177.00000006357823,"width":375.62879999999996,"height":84.924805283546448}},{"text":"Match vector spaces across languages or modalities.","targetRectangle":{"y":569.00000095367432,"x":227.00000234331401,"width":799.67999999999984,"height":47.05920422077179}},{"text":"Example: bilingual word embeddings (align English & Italian spaces without parallel data).","targetRectangle":{"y":617.00000107288361,"x":227.00000234331401,"width":1016.2655999999999,"height":87.05920422077179}},{"text":"Couplings capture soft correspondences between vocabularies.","targetRectangle":{"y":705.0000011920929,"x":227.00000234331401,"width":1023.5231999999996,"height":48.025366330146881}},{"text":"Uncertainty-aware mappings via probabilistic transport","targetRectangle":{"y":754.00000131130219,"x":177.00000006357823,"width":940.9152000000006,"height":84.924805283546448}},{"text":"Unlike Monge maps, couplings allow splitting mass → captures uncertainty.","targetRectangle":{"y":840.00000190734863,"x":227.00000234331401,"width":960.9263999999996,"height":87.06921398639679}},{"text":"Useful when multiple plausible correspondences exist (e.g., many-to-many)","targetRectangle":{"y":928.01001179218292,"x":227.00000234331401,"width":1050.7055999999993,"height":88.05920422077179}},{"text":"Applications: shape matching under noise, multimodal prediction.","targetRectangle":{"y":1017.0100119113922,"x":227.00000234331401,"width":983.43839999999977,"height":47.05920422077179}},{"text":"Screen Shot 2022-05-14 at 11.20.29 AM.png","targetRectangle":{"y":-134,"x":518.5,"width":883,"height":122}}],"baseLayer":{"animations":[],"initialState":{"affineTra