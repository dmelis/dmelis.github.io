59375,"x":185.80000045776364,"width":839.94623999999999,"height":88.232324504852272}},{"text":"Showed that the heat and Fokker-Planck equations can be recovered as the gradient flows of certain energies.","targetRectangle":{"y":382.72288846969604,"x":185.80000045776364,"width":906.95808000000011,"height":90.197519817352315}},{"text":"Impact:","targetRectangle":{"y":473.92288875579834,"x":165.80000045776364,"width":124.07040000000001,"height":65.477520503997766}},{"text":"Sparked development of “Otto calculus”: treating probability measures as an (￼-dim) Riemannian manifold.","targetRectangle":{"y":540.40288972854614,"x":185.80000045776364,"width":895.26145794392551,"height":96.834441500690559}},{"text":"Provided a powerful bridge between PDE theory, optimal transport, and variational methods.","targetRectangle":{"y":638.20500701048672,"x":185.80000045776364,"width":884.56320000000005,"height":88.232324504852158}},{"text":"Practical Importance:","targetRectangle":{"y":727.40500729658902,"x":165.80000045776364,"width":329.63327999999996,"height":65.232325220108009}},{"text":"David Kinderlehrer","targetRectangle":{"y":475.08505249023438,"x":1406.556808959961,"width":230.77599999999984,"height":33.21600341796875}},{"text":"equation.pdf","targetRectangle":{"y":588.60289001464844,"x":618.56032045776362,"width":38.657297943925187,"height":48.634441214588151}},{"text":"Felix_Otto.jpg","targetRectangle":{"y":240.21624755859375,"x":1681.3631286621094,"width":218.45019245147705,"height":225.40625}},{"text":"Felix Otto","targetRectangle":{"y":475.08505249023438,"x":1730.1718939208984,"width":120.82000000000016,"height":33.21600341796875}},{"text":"pasted-movie.png","targetRectangle":{"y":242.19684547185898,"x":1149.1698162555695,"width":199.9375,"height":225.00000286102295}},{"text":"pasted-movie.png","targetRectangle":{"y":532.536376953125,"x":1113.28857421875,"width":817.32684326171875,"height":494.44140510517173}},{"text":"Kinderlehrer_david.jpg","targetRectangle":{"y":240.2