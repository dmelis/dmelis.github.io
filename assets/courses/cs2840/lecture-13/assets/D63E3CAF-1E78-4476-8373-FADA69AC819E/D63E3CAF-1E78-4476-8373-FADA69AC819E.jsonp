9707539882,"width":202.33276261682249,"height":75.283484037345829}},{"text":"￼             ( = ￼, local linear approximatiuon of the quadractic term)","targetRectangle":{"y":743.8158950210377,"x":255.99999910990391,"width":1413.6666674959677,"height":61.116674809244728}},{"text":"￼      (solved via Sinkhorn )","targetRectangle":{"y":805.87336572871993,"x":255.99999910990391,"width":905.0271190787862,"height":82.447534323263426}},{"text":"Notes:","targetRectangle":{"y":889.26169595042086,"x":171.99999707539882,"width":98.313600000000008,"height":46.05920398235321}},{"text":"solves an entire (regularized) OT problem for each iteration","targetRectangle":{"y":936.26169583121157,"x":221.99999921208337,"width":784.56839999999966,"height":35.147195434570335}},{"text":"can be interpreted as a mirror-descent scheme (￼ KL projection of gradient into constraint set)","targetRectangle":{"y":972.26169583121157,"x":221.99999921208337,"width":1247.8405485981302,"height":41.373048949910071}},{"text":"equation.pdf","targetRectangle":{"y":522.25811663431546,"x":171.99999707539882,"width":1050.5885956438919,"height":96.392702671710708}},{"text":"equation.pdf","targetRectangle":{"y":813.57336559758971,"x":255.99999910990391,"width":529.14391907878655,"height":74.747534454393644}},{"text":"equation.pdf","targetRectangle":{"y":751.51589488990749,"x":255.99999910990391,"width":280.37135230842705,"height":47.283484514182987}},{"text":"equation.pdf","targetRectangle":{"y":254,"x":780.62380268287552,"width":37.583484112149563,"height":47.283484514182987}},{"text":"equation.pdf","targetRectangle":{"y":254,"x":750.827197075399,"width":20.455805607476577,"height":47.283484514182987}},{"text":"equation.pdf","targetRectangle":{"y":972.26169583121157,"x":852.65939921208326,"width":32.885548598130868,"height":41.373048949910071}},{"text":"equation.pdf","targetRectangle":{"y":751.51589488990749,"x":705.34575141833102,"width":190.74811518754086,"height":53.416674940374946}},{"text":"equation.pdf","t