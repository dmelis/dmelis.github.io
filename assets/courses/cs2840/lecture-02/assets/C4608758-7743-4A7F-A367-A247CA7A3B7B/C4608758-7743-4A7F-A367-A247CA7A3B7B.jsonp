,"texture":"3F4A2CEB3F4B0C38898A90C4862DD081"}]}]},"effects":[],"duration":0.001,"type":"buildIn","attributes":{"direction":0},"name":"apple:bc-appear","objectID":"50E918B9-00DD-460E-AEB3-884F176DE09B"}],"automaticPlay":false,"hyperlinks":[],"accessibility":[{"text":"equation.pdf","targetRectangle":{"y":383.20150756835938,"x":1299.436767578125,"width":27.551999999999907,"height":31.343999999999994}},{"text":"equation.pdf","targetRectangle":{"y":471.38919067382812,"x":1279.953369140625,"width":207.4661111111111,"height":24.795000000000016}},{"text":"equation.pdf","targetRectangle":{"y":265.47467041015625,"x":1113.5113525390625,"width":26.591998414993213,"height":42.383997473716704}},{"text":"?","targetRectangle":{"y":223.36532497406006,"x":1037.9334716796875,"width":21.127999999999929,"height":43.936004638671875}},{"text":"equation.pdf","targetRectangle":{"y":508.20000100135803,"x":596.10335806722014,"width":21.763863925233636,"height":45.93252781377771}},{"text":"equation.pdf","targetRectangle":{"y":518.141357421875,"x":963.5113525390625,"width":26.591998414993327,"height":42.383997473716704}},{"text":"equation.pdf","targetRectangle":{"y":475.8681640625,"x":1037.436767578125,"width":27.551999999999907,"height":31.343999999999994}},{"text":"equation.pdf","targetRectangle":{"y":528.0255126953125,"x":1114.6026611328125,"width":25.055998506546075,"height":21.695998706817591}},{"text":"equation.pdf","targetRectangle":{"y":383.20150756835938,"x":1440.1033935546875,"width":34.12799796581271,"height":32.543998060226443}},{"text":"equation.pdf","targetRectangle":{"y":275.81866455078125,"x":966.138671875,"width":25.055998506546075,"height":21.695998706817647}},{"text":"Properties of Monge Problem","targetRectangle":{"y":52,"x":199.46400000000028,"width":1521.0719999999992,"height":132.751220703125}},{"text":"Does the solution (the Monge map) always exist?","targetRectangle":{"y":257,"x":170.99999806722008,"width":715.17504000000031,"height":38.086083984375023}},{"text":"No! Example: ","targetRectangle":{"y":296,"x":220.99999806722008,"width":204.32640000000004,"height":51.68608412742617}},{"text":"Is the solution unique?","targetRectangle":{"y":348.60000014305115,"x":170.99999806722008,"width":329.53344000000004,"height":72.086084342002891}},{"text":"No! Example: ","targetRectangle":{"y":421.60000050067902,"x":220.99999806722008,"width":204.32640000000004,"height":51.68608412742617}},{"text":"Is the problem symmetric on ￼ and ￼?","targetRectangle":{"y":474.20000064373016,"x":170.99999806722008,"width":558.14415252336448,"height":80.169190574205686}},{"text":"No! ","targetRectangle":{"y":555.28310723356083,"x":220.99999806722008,"width":59.829119999999989,"height":58.486084198951744}},{"text":"Is the optimization problem convex? ","targetRectangle":{"y":614.68310744813755,"x":170.99999806722008,"width":538.07040000000006,"height":72.086084342002891}},{"text":"No! Highly non-convex, set of push forwards is non-convex","targetRectangle":{"y":687.68310780576542,"x":220.99999806722008,"width":865.02528000000029,"height":51.68608412742617}},{"text":"Makes numerical solution fragile, especially in high dim","targetRectangle":{"y":740.28310794881656,"x":220.99999806722008,"width":801.05088000000023,"height":51.68608412742617}},{"text":"Suppose the solution exists. Is it “nice”?","targetRectangle":{"y":792.88310809186771,"x":170.99999806722008,"width":588.23807999999997,"height":72.086084342002891}},{"text":"No! It may be e.g. discontinuous ","targetRectangle":{"y":865.88310844949558,"x":220.99999806722008,"width":481.27679999999998,"height":51.68608412742617}},{"text":"In some settings (e.g., convex cost + regular densities), the solution is smooth","targetRectangle":{"y":918.48310859254673,"x":220.99999806722008,"width":1132.6080000000004,"height":51.68608412742617}},{"text":"equation.pdf","targetRectangle":{"y":508.20000100135803,"x":691.04610199245371,"width":19.950208598130871,"height":46.169190216577817}}],"baseLayer":{"animations":[],"ini