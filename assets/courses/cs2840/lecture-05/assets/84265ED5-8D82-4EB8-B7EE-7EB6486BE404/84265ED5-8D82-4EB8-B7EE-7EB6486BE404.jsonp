ectangle":{"y":555.54232788085938,"x":592.85903578850571,"width":408.82135073925599,"height":66.509911718211242}},{"text":"equation.pdf","targetRectangle":{"y":272,"x":1326.5889165658389,"width":412.33413661308418,"height":69.975439964183067}},{"text":"Let ￼, ￼. Then: ￼","targetRectangle":{"y":272,"x":183.99999709447229,"width":1554.9230560844508,"height":69.975439964183067}},{"text":"Can solve via Bregman Iterative Projections ","targetRectangle":{"y":343.23879445637056,"x":183.99999709447229,"width":888.27743999999984,"height":90.336645412445137}},{"text":"One can show: Sinkhorn iteration ￼ Bregman projections","targetRectangle":{"y":618.03879417026826,"x":183.99999709447229,"width":1164.4820500934579,"height":101.09496482367831}},{"text":"Therefore: EOT = KL projection of cost into feasible set (transport polytope)","targetRectangle":{"y":720.397113486134,"x":183.99999709447229,"width":1572.7929599999989,"height":91.291205959320109}},{"text":"Typically, we want to use Sinkhorn since it operates on vectors","targetRectangle":{"y":812.99711339076657,"x":183.99999709447229,"width":1260.9235199999998,"height":90.336645412445023}},{"text":"But this view opens the door to other types of projections and constraint sets","targetRectangle":{"y":904.59711329539914,"x":183.99999709447229,"width":1593.6383999999994,"height":91.291205959320109}},{"text":"equation.pdf","targetRectangle":{"y":655.63879407490083,"x":866.75583709447233,"width":50.469250093457958,"height":63.494964919045742}},{"text":"equation.pdf","targetRectangle":{"y":272,"x":717.65144243279008,"width":458.46227413304894,"height":69.975439964183067}},{"text":"equation.pdf","targetRectangle":{"y":272,"x":260.07231709447228,"width":432.49240533831778,"height":66.816479386687718}},{"text":"Iterative Bregman Projections","targetRectangle":{"y":442.54232788085938,"x":194.54994201660156,"width":624.9319999999999,"height":52.72369384765625}},{"text":"Repeat until convergence:","targetRectangle":{"y":496.54232788085938